ty w:val="9"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/><w:spacing w:after="120" w:before="360"/><w:outlineLvl w:val="0"/></w:pPr><w:rPr><w:rFonts w:ascii="Source Sans 3" w:hAnsi="Source Sans 3" w:cs="Source Sans 3"/><w:color w:val="0F4761"/><w:sz w:val="36"/></w:rPr></w:style><w:style w:customStyle="1" w:styleId="FirstParagraph" w:type="paragraph"><w:name w:val="First Paragraph"/><w:basedOn w:val="BodyText"/><w:next w:val="BodyText"/><w:qFormat/></w:style></w:styles>
